# AI产业链先行信号雷达 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# AI分析引擎 (OpenAI兼容API)
AI_API_BASE=https://zyapi.tuluo.top:8888/v1
AI_API_KEY=your_api_key_here
AI_MODEL=MiniMax-M2.7

# MiMo LLM Proxy (VPS本地, 可选)
# MIMO_PROXY_URL=http://localhost:3001/open-apis/bot/chat
# MIMO_SERVICE_TOKEN=
# MIMO_USER_ID=
# MIMO_COOKIE=

# Telegram推送 (可选)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
